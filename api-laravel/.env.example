# api-laravel environment reference
# ----------------------------------
# One row per variable the Laravel port reads (grepped from env() calls in
# config/, app/, database/). LAGO_*/SIDEKIQ_* names match Rails 1:1 so the
# monorepo's docker-compose x-backend-environment anchor works unchanged —
# see the "Rails docker-compose anchor" column mapping in DEPLOY.md.
#
# Two deviations from Rails naming (handled by the compose overlay, which
# sets both):
#   - DATABASE_URL  -> Laravel reads DB_URL (config/database.php 'url' key)
#   - RAILS_ENV     -> Laravel reads APP_ENV

# --- Application ---------------------------------------------------------
APP_NAME=Lago
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

# Rails credentials' secret_key_base. Used verbatim as the HS256 signing key
# by App\Support\Utils\AuthToken (mirrors Rails' ApiAuthentication); must be
# >= 32 bytes.
SECRET_KEY_BASE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ------------------------------------------------------------
# Laravel's config/database.php takes either discrete DB_* vars or a single
# URL via DB_URL. In containers set DB_URL to the Rails DATABASE_URL value
# (postgresql://user:pass@host:5432/lago?search_path=public) and the
# discrete vars are ignored. The frozen-schema loader
# (database/migrations/0001_01_01_000000_load_frozen_schema.php) is the only
# migration — `php artisan migrate --force` builds the whole schema.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=lago
DB_USERNAME=postgres
DB_PASSWORD=postgres
# DB_URL=postgresql://postgres:postgres@127.0.0.1:5433/lago?search_path=public

# --- Redis / queues ------------------------------------------------------
# phpredis (compiled into the Docker image) or predis/predis (dev default).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Full-URL forms: config/database.php reads REDIS_URL for the default and
# cache redis connections; config/lago.php reads LAGO_REDIS_CACHE_URL for the
# Lago::RedisConfigBuilder cache connection (Rails: LAGO_REDIS_CACHE_URL).
# REDIS_URL=redis://127.0.0.1:6379
# LAGO_REDIS_CACHE_URL=redis://127.0.0.1:6379

# Queue backend. Production containers use redis (Horizon / queue:work);
# the sqlite/database default only fits local play.
QUEUE_CONNECTION=database

# --- Sidekiq queue-split flags (job routing) ----------------------------
# When a flag is truthy, matching jobs enqueue on their dedicated queue
# (consumed by the dedicated worker); otherwise they stay on the general
# queues. Mirrors Rails' SIDEKIQ_* routing in app/jobs. The full queue list:
# high_priority, default, mailers, clock, providers, webhook, invoices,
# integrations, low_priority, long_running, events, billing, pdfs, payments,
# alerts, analytics, wallets.
SIDEKIQ_EVENTS=false
SIDEKIQ_PDFS=false
SIDEKIQ_BILLING=false
SIDEKIQ_CLOCK=false
SIDEKIQ_WEBHOOK=false
SIDEKIQ_ALERTS=false
SIDEKIQ_PROVIDERS=false
SIDEKIQ_PAYMENTS=false
SIDEKIQ_WALLETS=false

# --- Lago LAGO_* surface (same names as Rails) ---------------------------
# Public base URLs
LAGO_API_URL=http://localhost:3000
LAGO_FRONT_URL=https://app.getlago.com
LAGO_DOMAIN=

# License gate (premium features; empty = OSS feature set)
LAGO_LICENSE=
LAGO_LICENSE_URL=http://license:3000

# Lago Data API (analytics proxy: DataApi::BaseService)
LAGO_DATA_API_URL=
LAGO_DATA_API_BEARER_TOKEN=

# Signup gate (Rails: ENV.fetch("LAGO_DISABLE_SIGNUP", "false") == "true")
LAGO_DISABLE_SIGNUP=false

# PDF generation (Gotenberg; Rails compose service `pdf`)
LAGO_PDF_URL=http://pdf:3000
LAGO_DISABLE_PDF_GENERATION=false

# Webhooks: outbound HTTP + RS256 signature key (path to the private PEM).
LAGO_WEBHOOK_TIMEOUT_SECONDS=30
LAGO_WEBHOOK_ATTEMPTS=3
LAGO_WEBHOOK_ALLOW_PRIVATE_URLS=false
LAGO_RSA_PRIVATE_KEY_PATH=
# LAGO_RSA_PRIVATE_KEY=  # raw key material — only read by Rails; the port
# reads the PEM from LAGO_RSA_PRIVATE_KEY_PATH.

# Mailers
LAGO_FROM_EMAIL=

# SMTP (config/mail.php)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Object storage (config/lago.php + config/filesystems.php). AWS_* names are
# the Laravel-native aliases; LAGO_USE_AWS_S3 / LAGO_USE_GCS switch features.
LAGO_USE_AWS_S3=false
LAGO_AWS_S3_ACCESS_KEY_ID=
LAGO_AWS_S3_SECRET_ACCESS_KEY=
LAGO_AWS_S3_REGION=us-east-1
LAGO_AWS_S3_BUCKET=
LAGO_AWS_S3_ENDPOINT=
LAGO_AWS_S3_PATH_STYLE=false
LAGO_USE_GCS=false
LAGO_GCS_PROJECT=
LAGO_GCS_BUCKET=
LAGO_GCS_KEYFILE_JSON_PATH=

# Misc feature flags / tuning read in app/ or config/
LAGO_CLICKHOUSE_ENABLED=false
LAGO_EVENTS_BATCH_MAX_LENGTH=
LAGO_API_KEY_CACHE_TTL=

# SMTP aliases read by config/mail.php (Rails: config.action_mailer.smtp_settings)
LAGO_SMTP_ADDRESS=
LAGO_SMTP_PORT=587
LAGO_SMTP_USERNAME=
LAGO_SMTP_PASSWORD=
LAGO_SMTP_DOMAIN=
LAGO_SMTP_AUTHENTICATION=

# Coverage ledger / inventory tooling (dev + CI only; see scripts/inventory)
LAGO_RAILS_PATH=/tmp/lago-api-exploration
LAGO_INVENTORY_PATH=

# --- Lighthouse (GraphQL) ------------------------------------------------
# The app cache refuses to unserialize objects, so parsed-query caching uses
# opcache mode (PHP files under bootstrap/cache) — keep this in production.
LIGHTHOUSE_QUERY_CACHE_MODE=opcache
LIGHTHOUSE_QUERY_CACHE_ENABLE=true

# --- Cache / session -----------------------------------------------------
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- AWS SDK aliases (Laravel-native names used by filesystems config) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
